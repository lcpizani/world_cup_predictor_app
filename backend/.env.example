DATABASE_URL=postgresql://user:password@localhost:5432/worldcupdb
JWT_SECRET=your-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
ENVIRONMENT=development
FOOTBALL_API_KEY=

# Gate user registration behind a shared secret. Leave empty for open registration
# (local dev only). In production, MUST be set to a strong random value, otherwise
# anyone can register. A user-supplied invite_code is accepted if it matches this
# value OR is a valid tournament invite code.
INVITE_CODE=

